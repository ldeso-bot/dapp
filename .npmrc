auto-install-peers=true
strict-peer-dependencies=false

# Package cooldown: Only install package versions published at least 7 days ago (10,080 minutes)
# This helps mitigate the risk of installing compromised packages

# TODO: Set to 10080 before release
#minimum-release-age=10080


# Prevents package scripts from running automatically during install for better security
ignore-scripts=true

# Enable npm audit checks for vulnerability scanning
audit=true